{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "deck-3dsdevkit": {
        "type": "local",
        "command": [
          "ssh",
          "-o", "StrictHostKeyChecking=no",
          "-o", "BatchMode=yes",
          "-o", "LogLevel=ERROR",
          "deck@steamdeck",
          "/home/deck/.deck-mcp-venv/bin/python3",
          "/home/deck/mcp/server.py"
        ],
        "environment": {
          "DKP_IMAGE": "docker.io/devkitpro/devkitarm"
        },
        "codemode": false
      }
    }
  }
}
